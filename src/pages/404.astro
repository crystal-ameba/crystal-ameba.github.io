---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <section class="notfound wrap">
    <p class="code">404</p>
    <h1>This page wandered off.</h1>
    <p class="sub">Like a single-celled organism, it may have moved by extending fingerlike projections elsewhere.</p>
    <div class="links">
      <a class="btn btn-primary" href="/">Back home</a>
      <a class="btn btn-ghost" href="/blog">Read the blog</a>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    text-align: center;
    padding: 130px 0;
  }
  .code {
    font-family: var(--mono);
    font-size: 72px;
    font-weight: 600;
    letter-spacing: -0.03em;
    margin: 0;
    line-height: 1;
  }
  .notfound h1 {
    font-size: clamp(26px, 4vw, 36px);
    margin: 18px 0 0;
    letter-spacing: -0.01em;
  }
  .notfound .sub {
    color: var(--muted);
    max-width: 46ch;
    margin: 16px auto 0;
  }
  .links {
    display: flex;
    gap: 12px;
    justify-content: center;
    margin-top: 30px;
  }
</style>
