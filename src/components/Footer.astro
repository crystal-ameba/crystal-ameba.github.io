---
const project = [
  { label: 'Documentation', href: 'https://crystal-ameba.github.io/ameba/' },
  { label: 'Rules reference', href: 'https://crystal-ameba.github.io/ameba/' },
  { label: 'Releases', href: 'https://github.com/crystal-ameba/ameba/releases' },
];

const community = [
  { label: 'GitHub', href: 'https://github.com/crystal-ameba/ameba' },
  { label: 'Blog', href: '/blog' },
  { label: 'Contributing', href: 'https://github.com/crystal-ameba/ameba/blob/master/CONTRIBUTING.md' },
];

const year = 2026;
---

<footer class="site-footer">
  <div class="wrap">
    <div class="foot">
      <div class="col brand-col">
        <img src="/ameba-logo.png" alt="ameba" width="54" height="22" />
        <p>A static code analysis tool for the Crystal programming language.</p>
      </div>
      <div class="col">
        <h4>Project</h4>
        {project.map((l) => <a href={l.href}>{l.label}</a>)}
      </div>
      <div class="col">
        <h4>Community</h4>
        {community.map((l) => <a href={l.href}>{l.label}</a>)}
      </div>
    </div>
    <div class="legal">
      <span>© {year} Ameba contributors · MIT licensed</span>
      <span>Built with Crystal</span>
    </div>
  </div>
</footer>
